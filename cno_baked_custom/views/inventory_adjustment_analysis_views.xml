<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- Inventory Adjustment Analysis List View -->
    <record id="view_inventory_adjustment_analysis_list" model="ir.ui.view">
        <field name="name">inventory.adjustment.analysis.list</field>
        <field name="model">inventory.adjustment.analysis</field>
        <field name="arch" type="xml">
            <list string="Inventory Adjustment Analysis"
                  create="0"
                  edit="0"
                  delete="0">
                <field name="adjustment_date"/>
                <field name="location_id"/>
                <field name="vendor_id"/>
                <field name="product_id"/>
<!--                <field name="last_move_date"/>-->
<!--                <field name="last_move_quantity"/>-->
                <field name="last_move_user_id"/>
                <field name="cost_price"/>
<!--                <field name="scheduled"/>-->
                <field name="on_hand"/>
                <field name="counted"/>
                <field name="difference"/>
                <field name="adjustment_cost"/>
                <field name="company_id"/>

            </list>
        </field>
    </record>


    <!-- Action -->
    <record id="action_inventory_adjustment_analysis" model="ir.actions.act_window">
        <field name="name">Inventory Adjustment Analysis</field>
        <field name="res_model">inventory.adjustment.analysis</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_inventory_adjustment_analysis_list"/>
        <field name="context">{}</field>
    </record>


    <!-- Menu -->
    <menuitem
        id="menu_inventory_adjustment_analysis"
        name="Inventory Adjustment Analysis"
        parent="stock.menu_warehouse_report"
        action="action_inventory_adjustment_analysis"
        sequence="51"
    />

</odoo>