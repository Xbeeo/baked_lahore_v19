<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="stock_scrap_report_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page scrap-page"
                         style="font-family:Arial,Helvetica,sans-serif;
                                color:#263449; font-size:11px;">

                        <style>
                            .scrap-page {
                                font-family: Arial, Helvetica, sans-serif;
                            }

                            .scrap-banner {
                                background-color: #17365D !important;
                                color: #FFFFFF !important;
                                padding: 22px 20px;
                                border-radius: 5px;
                                margin-bottom: 20px;
                                border-bottom: 5px solid #D5A84C;
                            }

                            .scrap-banner h2 {
                                color: #FFFFFF !important;
                                font-size: 25px;
                                font-weight: bold;
                                margin: 0;
                                letter-spacing: .5px;
                            }

                            .scrap-banner-line {
                                height: 2px;
                                width: 55px;
                                background: #D5A84C;
                                margin-top: 10px;
                            }

                            .scrap-grid {
                                margin-left: -6px;
                                margin-right: -6px;
                            }

                            .scrap-grid > div {
                                padding-left: 6px;
                                padding-right: 6px;
                                margin-bottom: 12px;
                            }

                            .scrap-card {
                                background: #F5F8FC !important;
                                border: 1px solid #DCE5EF;
                                border-radius: 5px;
                                padding: 12px 13px;
                                min-height: 76px;
                                border-top: 3px solid #567DA8;
                            }

                            .scrap-card.accent-gold {
                                border-top-color: #D5A84C;
                            }

                            .scrap-card.accent-teal {
                                border-top-color: #398C8A;
                            }

                            .scrap-card.accent-blue {
                                border-top-color: #315B91;
                            }

                            .scrap-card.accent-slate {
                                border-top-color: #8799AD;
                            }

                            .scrap-label {
                                color: #71839A !important;
                                font-size: 9px;
                                font-weight: bold;
                                text-transform: uppercase;
                                letter-spacing: .8px;
                                margin-bottom: 8px;
                            }

                            .scrap-value {
                                color: #17365D !important;
                                font-size: 12px;
                                font-weight: bold;
                                line-height: 1.6;
                                overflow-wrap: break-word;
                            }

                            .scrap-value .scrap-tag {
                                display: inline-block;
                                background: #E5EDF7 !important;
                                color: #17365D !important;
                                border: 1px solid #CBD9E9;
                                border-radius: 4px;
                                padding: 4px 8px;
                                margin: 2px 4px 3px 0;
                                font-size: 10px;
                                font-weight: bold;
                            }

                            .scrap-reason-card {
                                background: #EDF3FA !important;
                                border: 1px solid #D5E0ED;
                                border-radius: 5px;
                                padding: 13px 14px;
                                border-left: 4px solid #D5A84C;
                                min-height: 76px;
                            }

                            .scrap-separator {
                                border: 0;
                                border-top: 1px solid #DCE5EF;
                                margin-top: 7px;
                                margin-bottom: 14px;
                            }
                        </style>

                        <!-- TITLE -->
                        <div class="scrap-banner">
                            <h2>Scrap Order Report</h2>
                            <div class="scrap-banner-line"></div>
                        </div>

                        <!-- ORDER DETAILS -->
                        <div class="row scrap-grid">
                            <div class="col-6">
                                <div class="scrap-card accent-gold">
                                    <div class="scrap-label">
                                        Order Reference
                                    </div>
                                    <div class="scrap-value">
                                        <span t-esc="o.name or '-'"/>
                                    </div>
                                </div>
                            </div>

                            <div class="col-6">
                                <div class="scrap-card accent-blue">
                                    <div class="scrap-label">
                                        Date
                                    </div>
                                    <div class="scrap-value">
                                        <span t-field="o.date_done"
                                              t-options='{"widget":"datetime","format":"dd/MM/yyyy hh:mm:ss a"}'/>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- PRODUCT DETAILS -->
                        <div class="row scrap-grid">
                            <div class="col-6">
                                <div class="scrap-card accent-teal">
                                    <div class="scrap-label">
                                        Product
                                    </div>
                                    <div class="scrap-value">
                                        <span t-esc="o.product_id.display_name or '-'"/>
                                    </div>
                                </div>
                            </div>

                            <div class="col-6">
                                <div class="scrap-card accent-slate">
                                    <div class="scrap-label">
                                        Source Document
                                    </div>
                                    <div class="scrap-value">
                                        <span t-esc="o.origin or '-'"/>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- QUANTITY AND VALUE -->
                        <div class="row scrap-grid">
                            <div class="col-6">
                                <div class="scrap-card accent-blue">
                                    <div class="scrap-label">
                                        Quantity
                                    </div>
                                    <div class="scrap-value">
                                        <span t-esc="o.scrap_qty"/>
                                        <span t-esc="o.product_uom_id.name if 'product_uom_id' in o._fields and o.product_uom_id else ''"/>
                                    </div>
                                </div>
                            </div>

                            <div class="col-6">
                                <div class="scrap-card accent-gold">
                                    <div class="scrap-label">
                                        Scrap Value
                                    </div>
                                    <div class="scrap-value"
                                         style="font-size:18px;">
                                        <span t-esc="'{:,.2f}'.format(o.scrap_value or 0.0)"/>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <hr class="scrap-separator"/>

                        <!-- BRANCH AND SCRAP REASONS -->
                        <div class="row scrap-grid">
                            <div class="col-6">
                                <div class="scrap-card accent-teal">
                                    <div class="scrap-label">
                                        Branch
                                    </div>
                                    <div class="scrap-value">
                                        <span t-esc="o.company_id.name or '-'"/>
                                    </div>
                                </div>
                            </div>

                            <div class="col-6">
                                <div class="scrap-reason-card">
                                    <div class="scrap-label">
                                        Scrap Reason
                                    </div>
                                    <div class="scrap-value">
                                        <t t-if="o.scrap_reason_tag_ids">
                                            <t t-foreach="o.scrap_reason_tag_ids"
                                               t-as="tag">
                                                <span class="scrap-tag"
                                                      t-esc="tag.name"/>
                                            </t>
                                        </t>
                                        <t t-else="">
                                            <span style="color:#8799AD;
                                                         font-weight:normal;">
                                                -
                                            </span>
                                        </t>
                                    </div>
                                </div>
                            </div>
                        </div>

                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
