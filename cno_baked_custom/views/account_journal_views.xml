<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_account_journal_form_inherit_suspense_account" model="ir.ui.view">
        <field name="name">account.journal.form.inherit.suspense.account</field>
        <field name="model">account.journal</field>
        <field name="inherit_id" ref="account.view_account_journal_form"/>
        <field name="arch" type="xml">

            <xpath expr="//field[@name='suspense_account_id']" position="attributes">
                <attribute name="domain">[('account_type', 'in', ['asset_current', 'asset_cash'])]</attribute>
            </xpath>

        </field>
    </record>

</odoo>