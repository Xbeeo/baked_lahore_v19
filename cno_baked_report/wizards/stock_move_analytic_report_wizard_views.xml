<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_stock_move_analytic_report_wizard_form" model="ir.ui.view">
        <field name="name">stock.move.analytic.report.wizard.form</field>
        <field name="model">stock.move.analytic.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Analytic Stock Move Report">
                <group>
                    <field name="date_from"/>
                    <field name="date_to"/>
                    <field name="analytic_account_id"/>
                </group>
                <footer>
                    <button name="action_print_report"
                            string="Print Excel"
                            type="object"
                            class="bt        res = super(
            PurchaseOrder,
            self.with_context(confirm_user_id=self.env.user.id)
        ).button_confirm()

        for order in self:

            # Validate Receipts
            for picking in order.picking_ids.filtered(lambda p: p.state not in ("done", "cancel")):
                picking.action_assign()

                for move in picking.move_ids:
                    move.quantity = move.product_uom_qty

                # picking.button_validate()

            # Create Vendor Bill
            bills = order.action_create_invoice()

            if bills:
                if isinstance(bills, dict):
                    bill = self.env["account.move"].browse(bills.get("res_id"))
                else:
                    bill = bills

                if bill:
                    # Set Bill Date to today
                    bill.invoice_date = fields.Date.context_today(self)

                    # Post the bill
                    billn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_stock_move_analytic_report_wizard" model="ir.actions.act_window">
        <field name="name">Product Expiry Report</field>
        <field name="res_model">stock.move.analytic.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_stock_move_analytic_report"
              name="Product Expiry Report"
              parent="stock.menu_warehouse_report"
              action="action_stock_move_analytic_report_wizard"
              sequence="50"/>
</odoo>